# ===== 会话 =====
# 签名 Cookie 密钥（生产环境务必修改）
SESSION_SECRET=sigmamentor-dev-secret-change-me

# ===== 教师注册邀请码（教师角色注册需要；学生注册无需）=====
TEACHER_INVITE_CODE=GOAI2026

# ===== LLM 调用层（I1）：三种模式 =====
# cloud = 云端 OpenAI 兼容 API（默认开发模式）
# local = 本机 llama-server（OpenAI 兼容协议，私有化部署/离线演示）
# off   = 关闭 LLM，全部走规则版（零配置可跑）
LLM_MODE=off

# --- cloud 模式 ---
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- local 模式（llama-server 一条命令启动）---
# llama-server -m models/qwen2.5-7b-instruct-q4_k_m.gguf --port 8080
LLM_LOCAL_URL=http://127.0.0.1:8080/v1
LLM_LOCAL_MODEL=qwen2.5-7b-instruct-q4_k_m

# ===== 数据库 =====
# MVP：SQLite（bun:sqlite 内置，文件位于 packages/db/sigmamentor.sqlite，无需配置）
# 生产：PostgreSQL 18（PRD I4，复赛前切换），届时使用：
# DATABASE_URL=postgres://postgres:dev@localhost:5432/sigmamentor
